   "t0": 33.37,
   "t1": 34.13
  },
  {
   "text": "mais d'en dessous.",
   "t0": 34.35,
   "t1": 35.09
  },
  {
   "text": "Et c'est là",
   "t0": 35.49,
   "t1": 36.05
  },
  {
   "text": "que tu peux agir.",
   "t0": 36.15,
   "t1": 36.86
  },
  {
   "text": "Voilà ce qui se passe.",
   "t0": 37.32,
   "t1": 38.21
  },
  {
   "text": "Ta",
